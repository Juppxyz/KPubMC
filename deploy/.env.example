# Kopieren nach .env, dann: chmod 600 .env
# Passwoerter nur hex erzeugen (URL-sicher, landen in der JDBC-URL):
#   openssl rand -hex 32

TZ=Europe/Berlin

MC_VERSION=26.3
MC_UID=1000
MC_GID=1000
# Heap fuer Paper; EX-44 hat 64 GB
MC_MEMORY=16G
# Harte Container-Grenze (Heap + Off-Heap-Puffer)
MC_MEM_LIMIT=20g

RCON_PASSWORD=

POSTGRES_DB=kpubmc
POSTGRES_USER=kpubmc
POSTGRES_PASSWORD=

# Cloudflare Zero Trust -> Networks -> Tunnels -> (Tunnel) -> Token
TUNNEL_TOKEN=
